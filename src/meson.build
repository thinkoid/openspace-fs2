foundation = static_library('foundation', foundation_src,
    include_directories: inc,
    dependencies: [sdl2_dep, openal_dep, gl_dep])

# The two toplevel-executable entry points live here with the corpus (their
# sources are under src/) but the executables themselves are declared in
# ../bin, which is what lands them in builddir/bin. Exported as File objects so
# bin/meson.build never has to reach back across the tree with '../src' paths.
game_main = files('freespace2/freespace.cc')
archiver_main = files('cfilearchiver/cfilearchiver.cc')
