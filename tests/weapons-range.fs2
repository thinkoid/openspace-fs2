#Wings		;! 0 total


#Events		;! 5 total

$Formula: ( when
   ( has-time-elapsed 2 )
   ( training-msg "Range hot" "Range hot" 0 8 )
)
+Name: Range hot
+Repeat Count: 1
+Interval: 1

$Formula: ( when
   ( < ( hits-left "Drone 01" ) 100 )
   ( training-msg "Good hit" "Good hit" 0 5 )
)
+Name: First hit
+Repeat Count: 1
+Interval: 1

$Formula: ( when
   ( is-destroyed-delay 0 "Drone 01" )
   ( training-msg "Drone down" "Drone down" 0 5 )
)
+Name: Drone 01 down
+Repeat Count: 1
+Interval: 1
+Objective:  XSTR("Destroy Drone 01", -1)
+Objective key:  XSTR("Press $LCtrl$", -1)

$Formula: ( when
   ( is-destroyed-delay 0 "Drone 02" "Drone 03" )
   ( training-msg "Drones down" "Drones down" 0 5 )
)
+Name: Drones 02 03 down
+Repeat Count: 1
+Interval: 1
+Objective:  XSTR("Destroy Drones 02 and 03", -1)

$Formula: ( when
   ( is-destroyed-delay 1 "Drone 01" "Drone 02" "Drone 03" )
   ( training-msg "Range clear" "Range clear" 0 8 )
)
+Name: Range clear
+Repeat Count: 1
+Interval: 1

